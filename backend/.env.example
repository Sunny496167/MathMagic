# Application Configuration
PORT=5000
NODE_ENV=development
APP_NAME=MathLearn

# Database
# For local MongoDB: mongodb://127.0.0.1:27017/mathlearn
# Or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/mathlearn

# Redis (Optional/Recommended for session blacklist and rate limiting)
# If left empty, backend falls back gracefully to in-memory/MongoDB storage
REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_min32chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_IN=1h
JWT_EMAIL_VERIFICATION_EXPIRES_IN=24h

# Google OAuth (For React Native Expo Google Sign-In & Web)
# Note: In React Native, the mobile app sends the idToken obtained from Google to /api/v1/auth/google
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_smtp_key
EMAIL_FROM="MathLearn Team <noreply@mathlearn.com>"

# Client / App URLs (For password reset links and CORS)
CLIENT_URL=http://localhost:3000
EXPO_APP_SCHEME=mathmagic://

# Allowed Origins for CORS (Comma-separated)
# e.g., http://localhost:3000,http://localhost:8081,http://192.168.1.100:8081
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
